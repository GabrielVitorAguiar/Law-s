rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function createsOwnDocument() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function readsOwnDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function updatesOwnDocument() {
      return signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow create: if createsOwnDocument();
      allow read, delete: if readsOwnDocument();
      allow update: if updatesOwnDocument();
    }
  }
}
