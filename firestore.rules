rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function createsOwnDocument() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function readsOwnDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function updatesOwnDocument() {
      return signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    function portalValido(codigo) {
      return exists(/databases/$(database)/documents/portais_cliente/$(codigo))
        && get(/databases/$(database)/documents/portais_cliente/$(codigo)).data.codigo == codigo;
    }

    function advogadoDoPortal(codigo) {
      return signedIn()
        && get(/databases/$(database)/documents/portais_cliente/$(codigo)).data.advogadoId == request.auth.uid;
    }

    match /processos_monitorados/{processoId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'numeroProcesso', 'tribunal', 'clienteId',
          'advogadoResponsavelId', 'dataCadastro', 'ativo',
          'primeiraConsultaFeita', 'ultimaConsulta',
          'ultimaMovimentacaoId', 'classeProcessual', 'assunto',
          'orgaoJulgador'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'numeroProcesso', 'tribunal', 'clienteId',
          'advogadoResponsavelId', 'dataCadastro', 'ativo',
          'primeiraConsultaFeita', 'ultimaConsulta',
          'ultimaMovimentacaoId', 'classeProcessual', 'assunto',
          'orgaoJulgador'
        ])
        && request.resource.data.id == processoId
        && request.resource.data.advogadoResponsavelId == request.auth.uid
        && request.resource.data.numeroProcesso is string
        && request.resource.data.numeroProcesso.matches('^[0-9]{7}-[0-9]{2}\\.[0-9]{4}\\.[0-9]\\.[0-9]{2}\\.[0-9]{4}$')
        && request.resource.data.ativo == true
        && request.resource.data.primeiraConsultaFeita == false
        && request.resource.data.classeProcessual == null
        && request.resource.data.assunto == null
        && request.resource.data.orgaoJulgador == null
        && request.resource.data.ultimaConsulta == null
        && request.resource.data.ultimaMovimentacaoId == null;
      allow read: if signedIn()
        && resource.data.advogadoResponsavelId == request.auth.uid;
      allow update, delete: if false;

      match /movimentacoes/{movimentacaoId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/processos_monitorados/$(processoId)).data.advogadoResponsavelId == request.auth.uid;
        allow write: if false;
      }
    }

    match /notificacoes_usuario/{notificacaoId} {
      allow read: if signedIn() && resource.data.usuarioId == request.auth.uid;
      allow write: if false;
    }

    // O código é o identificador aleatório e não enumerável do portal do cliente.
    // Não há permissão para listar portais sem autenticação do advogado responsável.
    match /portais_cliente/{codigo} {
      allow get: if resource.data.codigo == codigo;
      allow list: if signedIn() && resource.data.advogadoId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.codigo == codigo
        && request.resource.data.advogadoId == request.auth.uid;
      allow update, delete: if advogadoDoPortal(codigo);

      match /mensagens/{mensagemId} {
        allow read: if portalValido(codigo);
        allow write: if advogadoDoPortal(codigo);
      }
    }

    // Coleções já existentes, cujo proprietário é definido por userId.
    match /clientes/{documentoId} {
      allow create: if createsOwnDocument();
      allow read, delete: if readsOwnDocument();
      allow update: if updatesOwnDocument();
    }

    match /processos/{documentoId} {
      allow create: if createsOwnDocument();
      allow read, delete: if readsOwnDocument();
      allow update: if updatesOwnDocument();
    }

    match /calendario/{documentoId} {
      allow create: if createsOwnDocument();
      allow read, delete: if readsOwnDocument();
      allow update: if updatesOwnDocument();
    }

    // Mantido temporariamente para o CRUD legado. Será restringido na Parte 3.
    match /jurisprudencias/{documentoId} {
      allow create: if createsOwnDocument();
      allow read, delete: if readsOwnDocument();
      allow update: if updatesOwnDocument();
    }
  }
}
